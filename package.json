{
  "name": "opencomputer-workbench",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev --port 3200 --strictPort",
    "dev:fixtures": "tsx e2e/dev.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p opencomputer/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "membership-id": "node scripts/membership-id.mjs",
    "doctor": "opencomputer doctor",
    "deploy:agents": "opencomputer deploy --alias development"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opencomputer/react": "0.2.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "arctic": "3.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@hono/vite-dev-server": "0.26.1",
    "@opencomputer/agent": "0.7.3",
    "@opencomputer/cli": "0.7.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.38",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "json-schema-to-ts": "3.1.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  }
}
