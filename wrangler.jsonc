{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencomputer-workbench",
  "main": "src/hosts/workers.ts",
  "compatibility_date": "2026-09-10",
  "observability": { "enabled": true },
  // The SPA is a static asset; the Worker sees only its own routes. There is
  // deliberately no KV, D1, queue, Durable Object or cron binding: the app
  // keeps nothing between requests (test/stateless.test.ts checks this).
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  }
}
