# Copy to .env.local for `npm run dev`; put the same keys in .dev.vars for `npx wrangler dev`.
# Never commit either file. Every value is read at startup; a missing one names itself and stops the app.
OPENCOMPUTER_API_KEY=            # your organization API key; server only
OPENCOMPUTER_PROJECT_ID=         # the project the workbench is scoped to
OPENCOMPUTER_ENVIRONMENT=development   # development or production: the environment the workbench uses
OPENCOMPUTER_AGENT_ID=           # the worker agent's id inside that project
OPENCOMPUTER_API_URL=https://app.opencomputer.dev   # optional; the OpenComputer origin
GITHUB_CLIENT_ID=                # the GitHub OAuth app used for sign-in (scope read:org)
GITHUB_CLIENT_SECRET=            # its client secret; server only
WORKBENCH_COOKIE_KEY=            # base64 of 32 random bytes (`openssl rand -base64 32`); rotating it signs everyone out
WORKBENCH_MEMBERSHIP=            # who may sign in: org:<id>, team:<org id>/<team id> or user:<id>; `npm run membership-id -- team:acme/platform` prints it
WORKBENCH_ORIGIN=http://localhost:3200   # the app's public origin; the OAuth callback is <origin>/auth/callback
# WORKBENCH_DEV_STUBS=1          # development stubs only; never set on a deployed workbench
# WORKBENCH_DEV_REPOS=[{"fullName":"acme/service","defaultBranch":"main"}]   # with the stubs: the repository list to offer
